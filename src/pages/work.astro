---
import Layout from '../layouts/Layout.astro'

const projects = [
  {
    title: 'Fragile Base',
    url: '/work/fragile-base',
    tag: 'Contemporary fashion house digital commerce',
    thumb: '/images/projects/fragile-base.webp',
    alt: 'Fragile Base digital flagship presentation showing contemporary tailoring and lookbook grid',
    bg: '#0e0e12',
  },
  {
    title: 'Netto Marken-Discount',
    url: '/work/netto',
    tag: 'Supermarket chain career & recruitment platform',
    thumb: '/images/projects/netto.webp',
    alt: 'Netto Marken-Discount digital career portal showing neighborhood branch finder and career paths',
    bg: '#16213e',
  },
  {
    title: 'OP-1 Field',
    url: '/work/op1',
    tag: 'Tactile synthesizer screen graphics & hardware UI',
    thumb: '/images/projects/op1.webp',
    alt: 'OP-1 Field synthesizer hardware interface screen graphics with 4-axis encoder mapping',
    bg: '#1c1d22',
  },
  {
    title: 'Seed',
    url: '/work/seed',
    tag: 'B2B SaaS financial operations platform',
    thumb: '/images/projects/seed.webp',
    alt: 'Seed B2B SaaS platform interface showing invoicing and subscription scheduling',
    bg: '#1a1a2e',
  },
  {
    title: 'xToken',
    url: '/work/xtoken',
    tag: 'Decentralized staking & liquidity terminal',
    thumb: '/images/projects/xtoken.webp',
    alt: 'xToken decentralized staking terminal interface showing asset analytics dashboard',
    bg: '#18122b',
  },
  {
    title: 'xToken Brand',
    url: '/work/xtoken-brand',
    tag: 'Protocol visual identity & design system styleguide',
    thumb: '/images/projects/xtoken-brand.png',
    alt: 'xToken brand identity design system showing logomark construction and electric color tokens',
    bg: '#251749',
  },
  {
    title: 'eDiye Studio',
    url: '/work/ediye',
    tag: 'Digital product design & development studio',
    thumb: '/images/projects/ediye.webp',
    alt: 'eDiye design and development studio web presence',
    bg: '#533483',
  },
]
---

<Layout title="Work – Selected Projects — Dennis Essien">
  <section class="page-work">
    <div class="page__inner">
      <h1 class="page__title">Work</h1>
      <p class="page__intro">Selected product design, hardware interfaces, brand systems, and digital flagships.</p>

      <div class="page__grid">
        {
          projects.map((item) => (
            <a href={item.url} class="project">
              <div class="project__thumb" style={`background: ${item.bg};`}>
                <img src={item.thumb} alt={item.alt} loading="lazy" decoding="async" />
              </div>
              <div class="project__info">
                <h3 class="project__title">{item.title}</h3>
                <span class="project__tag">{item.tag}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .page-work {
    padding: 6rem 2rem 8rem;

    .page__inner {
      max-width: 68rem;
      margin: 0 auto;
    }

    .page__title {
      margin: 0 0 1rem;
      font: 700 4rem / 0.9 font-family(bigger);
      text-transform: uppercase;
      color: color(secondary);
      letter-spacing: -0.01em;
    }

    .page__intro {
      margin: 0 0 3.5rem;
      font: 200 1.35rem / 1.5 font-family(editorial);
      color: color(secondary);
      opacity: 0.85;
      max-width: 48rem;
    }

    .page__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: color(secondary);
      border: 1px solid color(secondary);

      @include mq(tablet) {
        grid-template-columns: repeat(2, 1fr);
      }

      @include mq(phone) {
        grid-template-columns: 1fr;
      }
    }

    .project {
      display: flex;
      flex-direction: column;
      background: color(primary);
      text-decoration: none;
      transition: opacity 0.25s ease, background-color 0.2s ease;

      &:hover {
        opacity: 0.88;

        .project__thumb img {
          transform: scale(1.03);
        }
      }

      &:active {
        transform: scale(0.99);
      }

      &__thumb {
        aspect-ratio: 16 / 10;
        width: 100%;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
          transition: transform 0.4s ease;
        }
      }

      &__info {
        padding: 1.25rem 1.25rem 1.5rem;
        border-top: 1px solid color(secondary);
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        flex-grow: 1;
      }

      &__title {
        margin: 0;
        font: 700 1.05rem / 1.25 font-family(fraktion);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: color(secondary);
      }

      &__tag {
        font: 200 0.92rem / 1.4 font-family(editorial);
        color: color(secondary);
        opacity: 0.75;
      }
    }
  }
</style>
